{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=ETOmniverse;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Log": {
    "ExtraInfo": {
      "AppName": "ETOmniverse.Api"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Logging": {
    "RequestBody": { "Enabled": false, "MaxBytes": 32768 },
    "Mask": { "AdditionalFields": [] },
    "Heartbeat": { "Enabled": false, "IntervalSeconds": 60 },
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "Errors": {
    "TypeBaseUrl": "https://et-omniverse/errors"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "OpenApi": {
    "Enabled": false
  },
  "ExternalServices": {
    "SampleEcho": {
      "BaseUrl": "http://localhost",
      "TimeoutSeconds": 10,
      "Retry": {
        "MaxAttempts": 3,
        "BaseDelayMs": 200
      },
      "CircuitBreaker": {
        "Enabled": false
      }
    }
  }
}

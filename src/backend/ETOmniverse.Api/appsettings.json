{
  "AllowedHosts": "*",
  "Log": {
    "ExtraInfo": {
      "AppName": "ETOmniverse.Api"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Logging": {
    "RequestBody": { "Enabled": false, "MaxBytes": 32768 },
    "Mask": { "AdditionalFields": [] },
    "Heartbeat": { "Enabled": false, "IntervalSeconds": 60 },
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  }
}
